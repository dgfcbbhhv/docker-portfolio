# 预警密钥（复制为 .env 后填写，不要提交真实密钥）
# SMTP 邮件通道（163 邮箱默认配置）
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
SMTP_USER=your@163.com
SMTP_PASS=your-smtp-auth-code
ALERT_TO=your@163.com
# 企业微信机器人
WECHAT_WEBHOOK=
# Telegram
TG_TOKEN=
TG_CHAT_ID=
# 通用 Webhook
WEBHOOK_URL=

# 长桥 OpenAPI（可选，美股/港股行情备援数据源）
# 凭据在 https://open.longbridge.cn 用户中心 → 应用凭证 获取
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_REGION=cn
